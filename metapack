#!/usr/bin/env bash
set -euo pipefail

repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
meta="$repo/meta"

die() {
    printf 'metapack: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'usage: metapack list | metapack <name> [show] | metapack <name> remove\n'
}

list() {
    local dir name packages files
    for dir in "$meta"/*/; do
        [[ -d $dir ]] || continue
        name="$(basename "$dir")"
        packages="$(grep -Ec '^(brew|cask|cargo|uv) ' "$dir/Brewfile" 2>/dev/null || true)"
        files="$(find "$dir/home" -type f 2>/dev/null | wc -l | tr -d ' ' || true)"
        printf '%-12s %3s packages %3s files\n' "$name" "${packages:-0}" "${files:-0}"
    done
}

link() {
    local name=$1 action=$2
    [[ -d $meta/$name/home ]] || return 0
    local -a trees
    trees=("$meta/$name/home"/*/)
    trees=("${trees[@]%/}")
    trees=("${trees[@]##*/}")
    stow --dir "$meta/$name/home" --target "$HOME" --no-folding "$action" "${trees[@]}"
}

[[ $# -ge 1 ]] || { usage; exit 1; }

case $1 in
list | -l | --list)
    list
    ;;
-h | --help | help)
    usage
    ;;
*)
    name=$1
    shift
    dir="$meta/$name"
    [[ -d $dir ]] || { list >&2; die "no such metapack: $name"; }
    case ${1-} in
    show | -s | --show)
        cat "$dir/Brewfile" 2>/dev/null || printf 'no packages\n'
        if [[ -d $dir/home ]]; then
            printf '\nstows:\n'
            find "$dir/home" -mindepth 1 -maxdepth 1 | sed "s|$dir/home/||" | sort
        fi
        ;;
    remove | unlink)
        link "$name" -D
        printf 'unlinked %s; packages left installed\n' "$name"
        ;;
    "")
        [[ -f $dir/Brewfile ]] && brew bundle install --file "$dir/Brewfile" --no-upgrade
        link "$name" -R
        printf 'installed %s\n' "$name"
        ;;
    *)
        usage >&2
        exit 1
        ;;
    esac
    ;;
esac
