{
    "mode": "{{ mode }}",
    "wallpaper": "{{ duh.wallpaper }}",
    "colors": {
<* for name, value in colors *>        "{{ name }}": "{{ value.default.hex }}"<* if {{ loop.last }} *><* else *>,<* endif *>
<* endfor *>    },
    "ansi": [
        <* if {{ is_dark_mode }} *>"{{ colors.surface_container_high.default.hex }}",
        "{{ colors.tertiary.default.hex }}",
        "{{ colors.secondary.default.hex }}",
        "{{ colors.tertiary_fixed.default.hex }}",
        "{{ colors.primary.default.hex }}",
        "{{ colors.primary_fixed.default.hex }}",
        "{{ colors.secondary_fixed.default.hex }}",
        "{{ colors.on_surface_variant.default.hex }}",
        "{{ colors.outline.default.hex }}",
        "{{ colors.tertiary.default.hex | lighten: 6.0 }}",
        "{{ colors.secondary.default.hex | lighten: 6.0 }}",
        "{{ colors.tertiary_fixed.default.hex | lighten: 6.0 }}",
        "{{ colors.primary.default.hex | lighten: 6.0 }}",
        "{{ colors.primary_fixed.default.hex | lighten: 6.0 }}",
        "{{ colors.secondary_fixed.default.hex | lighten: 6.0 }}",
        "{{ colors.on_surface.default.hex }}"<* else *>"{{ colors.surface_container_high.default.hex }}",
        "{{ colors.tertiary.default.hex }}",
        "{{ colors.secondary.default.hex }}",
        "{{ colors.on_tertiary_fixed_variant.default.hex }}",
        "{{ colors.primary.default.hex }}",
        "{{ colors.on_primary_fixed_variant.default.hex }}",
        "{{ colors.on_secondary_fixed_variant.default.hex }}",
        "{{ colors.on_surface_variant.default.hex }}",
        "{{ colors.outline.default.hex }}",
        "{{ colors.tertiary.default.hex | lighten: -6.0 }}",
        "{{ colors.secondary.default.hex | lighten: -6.0 }}",
        "{{ colors.on_tertiary_fixed_variant.default.hex | lighten: -6.0 }}",
        "{{ colors.primary.default.hex | lighten: -6.0 }}",
        "{{ colors.on_primary_fixed_variant.default.hex | lighten: -6.0 }}",
        "{{ colors.on_secondary_fixed_variant.default.hex | lighten: -6.0 }}",
        "{{ colors.on_surface.default.hex }}"<* endif *>
    ]
}
